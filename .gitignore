# Local scratch and Codex delivery areas
work/
outputs/
tmp/
exports/prototype_t04/

# Python/CadQuery caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
.venv*/

# CAD application temporary/backup files
*.FCStd1
*.bak
*.tmp
~$*

# OS metadata
.DS_Store
Thumbs.db

# Vendor download archives are retained locally; extracted STEP and hashes are tracked.
references/vendor/gobilda/t06/source_archives/

# Generated exports are reproducible; keep source and approved release artifacts
exports/step/*
exports/stl/*
exports/drawings/*
!.gitkeep
!exports/step/t04_c04b1_17mm_capstan_m3.step
!exports/step/t04_c04b1_25deg_paddle_slider_m3.step
!exports/step/t04_c04b1_servo_rail_bracket_m3.step
!exports/step/t04_c04b1_capstan_fixture_assembly_m3.step
!exports/step/t04_c04b1_fusion360_assembly_m3.step
!exports/stl/t04_c04b1_17mm_capstan_m3.stl
!exports/stl/t04_c04b1_25deg_paddle_slider_m3.stl
!exports/stl/t04_c04b1_servo_rail_bracket_m3.stl
!exports/drawings/t04_c04b1_capstan_fixture_m3_preview.png

# Large regenerable launcher exports and vendor BREP caches stay local-only.
# Reproduce with: T06_VENDOR_REFRESH=1 (see cad/README.md).
cad/output/paddle_launcher_feasible_*.step
cad/output/paddle_launcher_feasible_*.glb
cad/output/paddle_launcher_feasible_*.stl
cad/output/vendor_solids/

# Motion-only simulation extract (structure removed).  Same local-only rule.
cad/output/paddle_launcher_motion_only_*.step
cad/output/paddle_launcher_motion_only_*.stl
cad/output/paddle_launcher_motion_only_*.glb

# Motion version (moving parts + ball path, no actuators).  Same rule.
cad/output/paddle_launcher_motion_free_*.step
cad/output/paddle_launcher_motion_free_*.stl
cad/output/paddle_launcher_motion_free_*.glb

# a' feeder geometry sets (NECTAR / POLLEN / shared).  Large regenerable exports,
# same local-only rule; the *_report.json and cad/output/inspection/ part files
# stay tracked.  Regenerate with cad/paddle_launcher_feeder_a_prime_shared.py.
cad/output/paddle_launcher_feeder_a_prime_*.step
cad/output/paddle_launcher_feeder_a_prime_*.stl
cad/output/paddle_launcher_feeder_a_prime_*.glb

# R35 hot-datum exports (DEC-0032): same local-only rule.  The STEP is ~180 MB and
# fully regenerable with cad/paddle_launcher_feeder_a_prime_shared_hot.py; the
# *_report.json stays tracked.
cad/output/_r35_hot/*.step
cad/output/_r35_hot/*.stl
cad/output/_r35_hot/*.glb
cad/output/_r35_hot/inspection/*.step

# R37 staging exports (DEC-0035 方向 B + DEC-0036 重叠清理): same local-only rule.
# Each STEP is ~170 MB and fully regenerable with
# cad/paddle_launcher_feeder_a_prime_shared_staging.py; the *_report.json and
# _r37_readback.json stay tracked.
cad/output/_r37_stage/*.step
cad/output/_r37_stage/*.stl
cad/output/_r37_stage/*.glb

# R48 motion-check delivery exports (DEC-0046): same local-only rule.  The STEP
# copies are ~170 MB and fully regenerable with cad/paddle_launcher_motion_check.py;
# delivery_readback.json / parts_*.json stay tracked.
cad/output/_motion_check/*.step
cad/output/_motion_check/*.stl
cad/output/_motion_check/*.glb

# R49 gate-drive delivery exports (DEC-0047): same local-only rule.  The STEP
# copy is ~187 MB and fully regenerable with cad/paddle_launcher_gate_drive_r49.py;
# the *_view.png / parts_*.json stay tracked.
cad/output/_r49_gate/*.step
cad/output/_r49_gate/*.stl
cad/output/_r49_gate/*.glb
cad/output/_r49_gate/tris_ctx_*.pkl

# R50 shooter-drive delivery exports (DEC-0048): same local-only rule.  The STEP
# copy is ~363 MB and fully regenerable with cad/paddle_launcher_shooter_drive_r50.py;
# the *_view.png / parts_*.json stay tracked.
cad/output/_r50_drive/*.step
cad/output/_r50_drive/*.stl
cad/output/_r50_drive/*.glb
cad/output/_r50_drive/*.pkl

# R51 shooter base swap (DEC-0049): 2026-10-01 whole-robot baseline readback +
# sliding-window drive exports.  STEP copies are ~414 MB and fully regenerable with
# cad/paddle_launcher_shooter_drive_r51.py; manifest.json / report_r51.json /
# plate_booleans_r51.json / *.png stay tracked.
cad/output/_r51_base/tris/
cad/output/_r51_base/*.step
cad/output/_r51_drive/*.step
cad/output/_r51_drive/*.stl
cad/output/_r51_drive/*.glb
cad/output/_r51_drive/*.pkl

# R52 shooter assembly (DEC-0050): R37 feeder + R49 gate on the R51 base.
# STEP copies are ~445 MB and fully regenerable with cad/paddle_launcher_shooter_drive_r52.py;
# readback_r52.json / report_r52_*.json / *.png stay tracked.
cad/output/_r52_drive/*.step
cad/output/_r52_drive/*.stl
cad/output/_r52_drive/*.glb
cad/output/_r52_drive/*.pkl
# R53 family (DEC-0051 / DEC-0052, V-0051..V-0056): preloaded spring clamp, then the
# rigid fixed-length stop ring that pins the clamp preload to geometry.
# STEP copies are ~446 MB and fully regenerable with
#   cad/paddle_launcher_shooter_lock_r53b.py / _r53f.py
# report_r53*.json and *.png stay tracked; _run_*.log is a transient console log.
cad/output/_r53b_auto/*.step
cad/output/_r53b_auto/*.stl
cad/output/_r53b_auto/*.glb
cad/output/_r53f_lock/*.step
cad/output/_r53f_lock/_run_*.log

# Desktop delivery archive (2026-10-13 copy).  Local-only; not a build input.
deliverables/

# R54 printed-frame consolidation (DEC-0053): one printed frame + plain M3
# through-bolts.  STEP copies are ~5 MB and fully regenerable with
#   cad/paddle_launcher_shooter_assembly_r54.py <variant> --step
# report_r54_*.json and sections/*.png stay tracked.
cad/output/_r54_frame/*.step
cad/output/_r54_frame/cache/
cad/output/_r54_frame/_run_*.log

# R55 rail-leg bolt-axis fix (DEC-0055 fix A): STEP copies are ~5 MB and fully regenerable with
#   cad/paddle_launcher_shooter_assembly_r55.py <variant> --step
cad/output/_r55_frame/*.step
cad/output/_r55_frame/cache/
cad/output/_r55_frame/_run_*.log
cad/output/_r55_run.log
cad/output/_r55_fit_probe.log
cad/output/_r55_print_probe.log
cad/output/_r55_vs_r54_diff.log
