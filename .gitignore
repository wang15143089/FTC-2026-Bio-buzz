# Local scratch and Codex delivery areas
work/
outputs/
tmp/
exports/prototype_t04/

# Python/CadQuery caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
.venv*/

# CAD application temporary/backup files
*.FCStd1
*.bak
*.tmp
~$*

# OS metadata
.DS_Store
Thumbs.db

# Vendor download archives are retained locally; extracted STEP and hashes are tracked.
references/vendor/gobilda/t06/source_archives/

# Generated exports are reproducible; keep source and approved release artifacts
exports/step/*
exports/stl/*
exports/drawings/*
!.gitkeep
!exports/step/t04_c04b1_17mm_capstan_m3.step
!exports/step/t04_c04b1_25deg_paddle_slider_m3.step
!exports/step/t04_c04b1_servo_rail_bracket_m3.step
!exports/step/t04_c04b1_capstan_fixture_assembly_m3.step
!exports/step/t04_c04b1_fusion360_assembly_m3.step
!exports/stl/t04_c04b1_17mm_capstan_m3.stl
!exports/stl/t04_c04b1_25deg_paddle_slider_m3.stl
!exports/stl/t04_c04b1_servo_rail_bracket_m3.stl
!exports/drawings/t04_c04b1_capstan_fixture_m3_preview.png

# Large regenerable launcher exports and vendor BREP caches stay local-only.
# Reproduce with: T06_VENDOR_REFRESH=1 (see cad/README.md).
cad/output/paddle_launcher_feasible_*.step
cad/output/paddle_launcher_feasible_*.glb
cad/output/paddle_launcher_feasible_*.stl
cad/output/vendor_solids/

# Motion-only simulation extract (structure removed).  Same local-only rule.
cad/output/paddle_launcher_motion_only_*.step
cad/output/paddle_launcher_motion_only_*.stl
cad/output/paddle_launcher_motion_only_*.glb

# Motion version (moving parts + ball path, no actuators).  Same rule.
cad/output/paddle_launcher_motion_free_*.step
cad/output/paddle_launcher_motion_free_*.stl
cad/output/paddle_launcher_motion_free_*.glb

# a' feeder geometry sets (NECTAR / POLLEN / shared).  Large regenerable exports,
# same local-only rule; the *_report.json and cad/output/inspection/ part files
# stay tracked.  Regenerate with cad/paddle_launcher_feeder_a_prime_shared.py.
cad/output/paddle_launcher_feeder_a_prime_*.step
cad/output/paddle_launcher_feeder_a_prime_*.stl
cad/output/paddle_launcher_feeder_a_prime_*.glb
